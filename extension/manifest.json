{
  "manifest_version": 3,
  "name": "Atlas New Tab",
  "version": "1.0.2",
  "key": "",
  "description": "A calm new tab page with live wallpapers, shortcuts, focus tools and search that uses your browser's default search engine.",
  "permissions": [
    "storage",
    "search",
    "alarms",
    "notifications",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "https://atlas-assistant-backend.vercel.app/*",
    "https://*.chromiumapp.org/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://wallhaven.cc/*",
    "https://*.wallhaven.cc/*",
    "https://pixabay.com/*",
    "https://cdn.pixabay.com/*",
    "https://wallpaperwaves.com/*",
    "https://*.wallpaperwaves.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
